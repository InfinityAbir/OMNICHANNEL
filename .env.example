# Copy to .env and fill in for local development. Never commit the real .env file.

# Postgres (docker-compose)
POSTGRES_DB=omnichannel
POSTGRES_USER=omnichannel
POSTGRES_PASSWORD=omnichannel_dev_only

# ASP.NET Core connection string equivalent (used by Omnichannel.Api in Development)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=omnichannel;Username=omnichannel;Password=omnichannel_dev_only

ASPNETCORE_ENVIRONMENT=Development

# OpenTelemetry OTLP exporter endpoint (optional in dev; leave unset to disable export)
OTEL_EXPORTER_OTLP_ENDPOINT=

# JWT signing (local dev uses `dotnet user-secrets` instead — see src/Omnichannel.Api).
# Generate a strong random value for any non-local environment; never reuse the dev one.
Jwt__SigningKey=

# SMTP (local dev uses `dotnet user-secrets` instead — see src/Omnichannel.Api).
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=Omnichannel
